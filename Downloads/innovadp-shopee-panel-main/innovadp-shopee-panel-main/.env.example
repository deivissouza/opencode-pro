# Arquivo de exemplo. Crie um arquivo chamado .env.local e preencha com suas credenciais.
# NUNCA envie o arquivo .env.local para o Git.

# ID do parceiro da Shopee Open Platform
SHOPEE_PARTNER_ID=

# Chave secreta do parceiro da Shopee Open Platform
SHOPEE_PARTNER_KEY=

# ID da sua loja na Shopee
SHOPEE_SHOP_ID=

# Token de acesso gerado para sua loja (pode ter validade, verifique a documentação da Shopee)
SHOPEE_ACCESS_TOKEN=

# (Opcional) Refresh token para renovação automática do access_token
SHOPEE_REFRESH_TOKEN=

# (Opcional) Chave de parceiro dedicada para verificação de assinatura do Mecanismo de Empurrar (Push)
# Use a "Chave de parceiro de teste push" mostrada no painel quando estiver testando o Push
SHOPEE_PUSH_PARTNER_KEY=

# (Opcional) URL e chave do Supabase para armazenar tokens automaticamente
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# (Opcional) Tabela/ID usada para armazenar os tokens no Supabase
SHOPEE_TOKEN_TABLE=shopee_tokens
SHOPEE_TOKEN_ID=default

# (Opcional) Ajustes da busca por pedidos escaneados
# Dias que o backend volta no histórico ao tentar casar códigos (padrão: 15)
SCAN_ORDER_LOOKBACK_DAYS=15
# Lista de status (separados por vírgula) que serão consultados ao procurar pedidos
SCAN_ORDER_STATUSES=READY_TO_SHIP,PROCESSED,SHIPPED
