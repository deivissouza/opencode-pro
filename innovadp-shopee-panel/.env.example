# Template para configurar `.env.local` e as variáveis de ambiente da Vercel.
# Copie este arquivo para `.env.local` no desenvolvimento e replique os
# mesmos valores no projeto da Vercel (Project > Settings > Environment Variables).
# Dica (CLI):
#   vercel env pull .env.local

# Credenciais principais da Shopee Open Platform
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_SHOP_ID=

# Tokens obtidos no callback OAuth (/api/shopee/oauth/callback)
# Se usar Vercel KV, estes valores iniciais serão copiados para o KV na primeira execução.
SHOPEE_ACCESS_TOKEN=
SHOPEE_REFRESH_TOKEN=

# Vercel KV (Redis) - Obrigatório para persistência de tokens e cache
# Obtenha estes valores criando um Storage > KV no painel da Vercel.
# OU use a integração "Upstash" do Marketplace.
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# Se usar Upstash direto do Marketplace, as variáveis podem ser estas:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Host da API (opcional). Apenas SHOPEE_API_URL é utilizado pelo código.
# SHOPEE_API_HOST é mantido aqui por compatibilidade.
SHOPEE_API_URL=https://partner.shopeemobile.com
# SHOPEE_API_HOST=https://partner.shopeemobile.com

# Chave dedicada para validar o Push (use a Live Push Key da Shopee)
SHOPEE_PUSH_PARTNER_KEY=

# Ajustes de consulta e cache (opcional)
SCAN_ORDER_STATUSES=READY_TO_SHIP,PROCESSED,SHIPPED
# Quantos dias para trás buscar pedidos ao escanear (recomendado: 15 para melhor performance)
SCAN_ORDER_LOOKBACK_DAYS=15
SHOPEE_MAX_ORDER_PAGES=5
TODAY_STATS_CACHE_MS=60000
